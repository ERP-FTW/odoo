<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_smart_import_user" model="res.groups">
        <field name="name">Smart Import User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_smart_import_manager" model="res.groups">
        <field name="name">Smart Import Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('smart_import_base.group_smart_import_user'))]"/>
    </record>

    <record id="seq_smart_import_session" model="ir.sequence">
        <field name="name">Smart Import Session</field>
        <field name="code">smart.import.session</field>
        <field name="prefix">SIMP%(y)s</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
