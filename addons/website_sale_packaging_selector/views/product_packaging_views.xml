<odoo>
    <record id="product_packaging_tree_view_selector" model="ir.ui.view">
        <field name="name">product.packaging.list.website.selector</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view"/>
        <field name="arch" type="xml">
            <field name="qty" position="after">
                <field name="website_sale_selectable"/>
                <field name="website_sale_default"/>
                <field name="website_sale_sequence"/>
            </field>
        </field>
    </record>

    <record id="product_packaging_form_view_selector" model="ir.ui.view">
        <field name="name">product.packaging.form.website.selector</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <group name="qty" position="inside">
                <field name="website_sale_selectable"/>
                <field name="website_sale_default"/>
                <field name="website_sale_sequence"/>
            </group>
        </field>
    </record>
</odoo>
