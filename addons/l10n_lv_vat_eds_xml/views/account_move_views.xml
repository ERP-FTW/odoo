<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_lv_eds" model="ir.ui.view">
        <field name="name">account.move.form.l10n.lv.eds</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']/group" position="inside">
                <group string="EDS">
                    <field name="l10n_lv_eds_dok_veids"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
                <field name="l10n_lv_eds_section" optional="hide"/>
                <field name="l10n_lv_eds_dar_veids" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="after">
                <field name="l10n_lv_eds_section"/>
                <field name="l10n_lv_eds_dar_veids"/>
            </xpath>
        </field>
    </record>
</odoo>
