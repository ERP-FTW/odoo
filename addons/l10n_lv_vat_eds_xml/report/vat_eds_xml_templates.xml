                            <PartneraValstsKods><t t-esc="o._xml_text(row['partner_country'])"/></PartneraValstsKods>
                            <PartneraPVN><t t-esc="o._xml_text(row['partner_vat'])"/></PartneraPVN>
                            <PartneraNosaukums><t t-esc="o._xml_text(row['partner_name'])"/></PartneraNosaukums>
                            <DokNumurs><t t-esc="o._xml_text(row['doc_number'])"/></DokNumurs>
                            <DokDatums><t t-esc="o._xml_text(row['doc_date'])"/></DokDatums>
                            <t t-if="o._should_nil(row['currency'])"><ValutasKods t-att="o._xml_nil_attr()"/></t>
                            <t t-else=""><ValutasKods><t t-esc="o._xml_text(row['currency'])"/></ValutasKods></t>
                            <VertibaBezPvn><t t-esc="o._xml_text(row['base_amount'])"/></VertibaBezPvn>
                            <t t-if="o._should_nil(row['vat_amount'])"><PvnVertiba t-att="o._xml_nil_attr()"/></t>
                            <t t-else=""><PvnVertiba><t t-esc="o._xml_text(row['vat_amount'])"/></PvnVertiba></t>
                        </R>
                    </t>
                </PVN1II>

                <PVN1III t-if="o.export_pvn1iii">
                    <t t-foreach="o._get_annex_rows('pvn1iii')" t-as="row">
                        <R>
                            <DarVeids><t t-esc="o._xml_text(row['dar_veids'])"/></DarVeids>
                            <DokVeids><t t-esc="o._xml_text(row['dok_veids'])"/></DokVeids>
                            <PartneraValstsKods><t t-esc="o._xml_text(row['partner_country'])"/></PartneraValstsKods>
                            <PartneraPVN><t t-esc="o._xml_text(row['partner_vat'])"/></PartneraPVN>
                            <PartneraNosaukums><t t-esc="o._xml_text(row['partner_name'])"/></PartneraNosaukums>
                            <DokNumurs><t t-esc="o._xml_text(row['doc_number'])"/></DokNumurs>
                            <DokDatums><t t-esc="o._xml_text(row['doc_date'])"/></DokDatums>
                            <VertibaBezPvn><t t-esc="o._xml_text(row['base_amount'])"/></VertibaBezPvn>
                            <t t-if="o._should_nil(row['vat_amount'])"><PvnVertiba t-att="o._xml_nil_attr()"/></t>
                            <t t-else=""><PvnVertiba><t t-esc="o._xml_text(row['vat_amount'])"/></PvnVertiba></t>
                        </R>
                    </t>
                </PVN1III>

                <PVN2 t-if="o.export_pvn2">
                    <t t-foreach="o._get_annex_rows('pvn2')" t-as="row">
                        <R>
                            <DarVeids><t t-esc="o._xml_text(row['dar_veids'])"/></DarVeids>
                            <DokVeids><t t-esc="o._xml_text(row['dok_veids'])"/></DokVeids>
                            <Pazime><t t-esc="o._xml_text(row['pazime'])"/></Pazime>
                            <PartneraValstsKods><t t-esc="o._xml_text(row['partner_country'])"/></PartneraValstsKods>
                            <PartneraPVN><t t-esc="o._xml_text(row['partner_vat'])"/></PartneraPVN>
                            <PartneraNosaukums><t t-esc="o._xml_text(row['partner_name'])"/></PartneraNosaukums>
                            <DokNumurs><t t-esc="o._xml_text(row['doc_number'])"/></DokNumurs>
                            <DokDatums><t t-esc="o._xml_text(row['doc_date'])"/></DokDatums>
                            <VertibaBezPvn><t t-esc="o._xml_text(row['base_amount'])"/></VertibaBezPvn>
                            <t t-if="o._should_nil(row['vat_amount'])"><PvnVertiba t-att="o._xml_nil_attr()"/></t>
                            <t t-else=""><PvnVertiba><t t-esc="o._xml_text(row['vat_amount'])"/></PvnVertiba></t>
                        </R>
                    </t>
                </PVN2>

                <PVN7I t-if="o.export_pvn7i"/>
            </DokPVNv7>
        </t>
    </template>
</odoo>
