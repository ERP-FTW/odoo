<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_inherit_extra_attachment" model="ir.ui.view">
    <field name="name">account.move.form.extra.attachment</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='other_info']" position="inside">
        <group string="Email Attachments">
          <field
            name="email_extra_attachment_ids"
            widget="many2many_binary"
            context="{'default_res_model': 'account.move', 'default_res_id': id}"
            domain="[('res_model', '=', 'account.move'), ('res_id', '=', id)]"
          />
          <div class="o_form_label">Note</div>
          <div class="text-muted">
            Files set here are attached automatically when you click
            “Send &amp; Print” (or “Send”).
          </div>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
