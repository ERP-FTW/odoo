<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fulcrum_import_wizard_form" model="ir.ui.view">
        <field name="name">mlr.fulcrum.import.wizard.form</field>
        <field name="model">mlr.fulcrum.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Fulcrum Smart Import">
                <header>
                    <field name="step" widget="statusbar" statusbar_visible="upload,plan"/>
                </header>
                <sheet>
                    <group invisible="step != 'upload'">
                        <group string="Files">
                            <field name="items_file" filename="items_filename"/>
                            <field name="items_filename" invisible="1"/>
                            <field name="bom_line_ids">
                                <list editable="bottom">
                                    <field name="filename"/>
                                    <field name="file_data" filename="filename"/>
                                </list>
                            </field>
                        </group>
                        <group string="Options">
                            <field name="auto_create_unknown_uom"/>
                            <field name="create_locations_putaway"/>
                            <field name="create_placeholder_missing_bom_children"/>
                            <field name="orderpoint_max_policy"/>
                            <field name="mapping_profile_id"/>
                        </group>
                    </group>
                    <group invisible="step != 'plan'">
                        <group string="Plan">
                            <field name="session_id" readonly="1"/>
                            <field name="plan_text" widget="text" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Issues">
                            <field name="issues_text" widget="text" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate Plan" type="object" name="action_generate_plan" class="btn-primary" invisible="step != 'upload'"/>
                    <button string="Dry Run" type="object" name="action_dry_run" class="btn-secondary" invisible="step != 'plan'"/>
                    <button string="Approve &amp; Import" type="object" name="action_approve_import" class="btn-primary" invisible="step != 'plan'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fulcrum_import_wizard" model="ir.actions.act_window">
        <field name="name">Fulcrum Smart Import</field>
        <field name="res_model">mlr.fulcrum.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
