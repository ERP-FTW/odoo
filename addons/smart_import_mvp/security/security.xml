<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_smart_import_manager" model="res.groups">
        <field name="name">Smart Import Manager</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <record id="seq_fulcrum_import_session" model="ir.sequence">
        <field name="name">Fulcrum Import Session</field>
        <field name="code">mlr.fulcrum.import.session</field>
        <field name="prefix">FIMP%(y)s</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
