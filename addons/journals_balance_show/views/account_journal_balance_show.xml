<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_journal_dashboard_kanban_view_balance" model="ir.ui.view">
        <field name="name">account.journal.inherit.dashboard.balance.kanban</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='JournalBodyBankCash']//t[@t-call='JournalChecks']" position="before">
                <div class="row" t-if="dashboard.show_balance" groups="journals_balance_show.show_gl_balance_group">
                    <div class="col overflow-hidden text-start">
                        <span>GL Balance</span>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr"><t t-out="dashboard.balance"/></span>
                    </div>
                </div>
            </xpath>

            <xpath expr="//t[@t-name='JournalBodySalePurchase']//t[@t-call='JournalChecks']" position="before">
                <div class="row" t-if="dashboard.show_balance" groups="journals_balance_show.show_gl_balance_group">
                    <div class="col overflow-hidden text-start">
                        <span>GL Balance</span>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr"><t t-out="dashboard.balance"/></span>
                    </div>
                </div>
            </xpath>

            <xpath expr="//t[@t-name='JournalMiscelaneous']//t[@t-call='JournalChecks']" position="before">
                <div class="row" t-if="dashboard.show_balance" groups="journals_balance_show.show_gl_balance_group">
                    <div class="col overflow-hidden text-start">
                        <span>GL Balance</span>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr"><t t-out="dashboard.balance"/></span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
