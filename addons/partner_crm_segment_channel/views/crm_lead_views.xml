<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_segment_channel" model="ir.ui.view">
        <field name="name">crm.lead.form.segment.channel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="after">
                <field name="segment"/>
                <field name="channel"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
                <field name="segment"/>
                <field name="channel"/>
            </xpath>
        </field>
    </record>
</odoo>
