<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_mail_issue" model="ir.ui.view">
        <field name="name">account.move.form.mail.issue.banner</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_email_issues"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-triangle"
                        string="Email Issues"
                        invisible="not mail_has_issue">
                    <field name="mail_issue_count" widget="statinfo" string="Email Issues"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="mail_has_issue" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not mail_has_issue">
                    <field name="mail_issue_text" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
