<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_phone_raw_ext" model="ir.ui.view">
        <field name="name">res.partner.form.phone.raw.extension</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='phone']" position="after">
                <group>
                    <field name="phone_raw" string="Phone Raw"/>
                    <field name="phone_extension" string="Phone Extension"/>
                    <button name="action_save_phone_raw"
                            type="object"
                            string="Save Phone"
                            class="oe_highlight"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
