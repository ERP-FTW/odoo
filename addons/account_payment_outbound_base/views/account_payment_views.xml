<odoo>
  <record id="view_account_payment_form_outbound_provider" model="ir.ui.view">
    <field name="name">account.payment.form.outbound.provider</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_send_outbound_payment" type="object" string="Send Outbound Payment" class="oe_highlight"
                attrs="{'invisible': [('can_send_outbound_payment', '=', False)]}"/>
        <button name="action_refresh_outbound_status" type="object" string="Refresh Outbound Status"
                attrs="{'invisible': [('can_refresh_outbound_status', '=', False)]}"/>
      </xpath>
      <xpath expr="//sheet/field[@name='available_journal_ids']" position="after">
        <field name="can_send_outbound_payment" invisible="1"/>
        <field name="can_refresh_outbound_status" invisible="1"/>
        <field name="is_outbound_provider_payment" invisible="1"/>
        <field name="outbound_transaction_id" invisible="1"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_outbound_transaction" type="object" class="oe_stat_button" icon="fa-exchange"
                attrs="{'invisible': [('outbound_transaction_id', '=', False)]}">
          <field name="outbound_transaction_id" string="Outbound Transaction" widget="statinfo"/>
        </button>
      </xpath>
      <xpath expr="//sheet/group[1]" position="after">
        <group string="Outbound Provider" attrs="{'invisible': [('is_outbound_provider_payment', '=', False)]}">
          <field name="outbound_provider_code" readonly="1"/>
          <field name="outbound_provider_state" readonly="1"/>
          <field name="outbound_transaction_id" readonly="1"/>
          <field name="outbound_last_sync_at" readonly="1"/>
          <field name="outbound_last_error" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
