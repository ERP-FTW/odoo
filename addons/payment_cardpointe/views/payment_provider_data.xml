<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_cardpointe" model="payment.provider">
        <field name="name">CardPointe</field>
        <field name="module_id" ref="base.module_payment_cardpointe"/>
        <field
            name="payment_icon_ids"
            eval="[(6, 0, [
                ref('payment.payment_icon_cc_american_express'),
                ref('payment.payment_icon_cc_discover'),
                ref('payment.payment_icon_cc_jcb'),
                ref('payment.payment_icon_cc_maestro'),
                ref('payment.payment_icon_cc_mastercard'),
                ref('payment.payment_icon_cc_visa'),
            ])]"
        />
        <field name="code">cardpointe</field>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="allow_tokenization">False</field>
    </record>

</odoo>
