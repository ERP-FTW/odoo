<odoo>
  <record id="sale_order_form_inherit_sale_type" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.sale.type</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='partner_details']/field[@name='partner_shipping_id']" position="after">
        <field name="sale_type_id"/>
      </xpath>
    </field>
  </record>
  <record id="sale_order_list_inherit_sale_type" model="ir.ui.view">
    <field name="name">sale.order.list.inherit.sale_type</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='team_id']" position="after">
        <field name="sale_type_id" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>
