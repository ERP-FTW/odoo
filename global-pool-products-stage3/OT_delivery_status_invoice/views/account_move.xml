<odoo>
    <record id="view_move_form_inherit_tracking" model="ir.ui.view">
        <field name="name">account.move.form.inherit.tracking</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="delivery_tracking_ref" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>