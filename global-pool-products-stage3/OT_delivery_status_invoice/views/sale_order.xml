<odoo>
    <record id="view_order_form_inherit_delivery_tracking_ref" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.delivery.tracking.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commitment_date']" position="after">
                <field name="carrier_tracking_ref"
                       placeholder="e.g. 1Z..., FedEx..., or internal reference"/>
            </xpath>
        </field>
    </record>
</odoo>
