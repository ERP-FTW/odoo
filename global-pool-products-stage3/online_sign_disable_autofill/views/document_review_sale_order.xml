<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_document_review" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.document.review</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_signature']/group/field[@name='signed_by']" position="after">
                    <field name="docs_reviewed" string="Docs reviewed" widget="boolean" />
            </xpath>
        </field>
    </record>
</odoo>