<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_settings_inherit" model="ir.ui.view">
        <field name="name">sale.order.settings.view.inherit.document.review</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='online_signature']" position="inside">
                <div invisible="not portal_confirmation_sign" class="content-group">
                    <field name="document_review_checkbox_enabled" invisible="1" />
                    <label for="document_review_checkbox_label" class="col-lg-4"/>
                    <field name="document_review_checkbox_label" required="True"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
