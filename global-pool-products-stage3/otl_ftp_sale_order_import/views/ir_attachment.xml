<odoo>
    <record id="sale_order_view_form_inherit_sftp_attachment" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sftp_attachment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="sftp_attachment_id" string="SFTP Downloaded File"/>
            </xpath>
        </field>
    </record>
</odoo>
