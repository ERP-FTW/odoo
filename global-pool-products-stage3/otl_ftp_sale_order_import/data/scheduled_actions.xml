<odoo>
    <data noupdate="1">
        <record id="ir_cron_sftp_import" model="ir.cron">
            <field name="name">FTP Integration for Sale Orders</field>
            <field name="model_id" ref="model_sftp_import"/>
            <field name="state">code</field>
            <field name="code">model.download_file_from_sftp()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
